{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Denki",
  "version": "0.1.0",
  "identifier": "com.zaha.denki",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Denki",
        "width": 480,
        "height": 370,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "base-uri": "'self'",
        "object-src": "'none'",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self'",
        "img-src": "'self' asset: http://asset.localhost data:",
        "style-src": "'self'",
        "script-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "A compact desktop music player",
    "longDescription": "Denki is a compact desktop music player with local library scanning, playback controls, a stereo spectrum visualizer, session restoration, and platform media controls.",
    "license": "GPL-3.0-only",
    "licenseFile": "../COPYING",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
